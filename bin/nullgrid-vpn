#!/bin/sh
# UIC VPN. Settings live in ~/.config/nullgrid-vpn.conf (NETID, optional PASSCMD), which is
# deliberately NOT in the repo since it holds your NetID.
#
# Every openconnect option — gateway, auth group, Duo mode, pinned cert — lives in the root
# helper and nowhere else, so there is one copy to update and the NOPASSWD sudoers rule
# cannot be bent into running anything but that fixed command.
# The pinned cert expires 2027-04-11; openconnect refuses loudly when it rotates.
set -e
conf="$HOME/.config/nullgrid-vpn.conf"
helper=/usr/local/bin/nullgrid-vpn-root

[ -f "$conf" ] || { echo "missing $conf — set NETID=yournetid" >&2; exit 1; }
. "$conf"
[ -n "$NETID" ] || { echo "set NETID= in $conf" >&2; exit 1; }
[ -x "$helper" ] || { echo "$helper not installed — see system/ in the nullgrid repo" >&2; exit 1; }

pw=''
if [ -n "$PASSCMD" ]; then
    pw=$(eval "$PASSCMD" 2>/dev/null || true)
    [ -n "$pw" ] || echo "keyring lookup returned nothing" >&2
else
    echo "no PASSCMD in $conf" >&2
fi

# The helper fixes --passwd-on-stdin, so the password always arrives on stdin; ask for it
# here with echo off rather than letting openconnect read a visible line off the terminal.
if [ -z "$pw" ]; then
    printf 'UIC password: ' >&2
    stty -echo 2>/dev/null
    read -r pw
    stty echo 2>/dev/null
    printf '\n' >&2
fi

# -n first: the sudoers rule makes this one command passwordless. sudo prompts on the tty,
# not stdin, so the piped password does not interfere with the fallback.
printf '%s\n' "$pw" | sudo -n "$helper" "$NETID" && exit 0
echo "passwordless sudo rule not active — falling back to a sudo prompt" >&2
printf '%s\n' "$pw" | sudo "$helper" "$NETID"

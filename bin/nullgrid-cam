#!/bin/sh
# nullgrid-cam [device] — webcam viewer. mpv already is a camera app: `s` takes the photo,
# `f` fullscreens, `q` quits. This only points it at the capture node, picks a format the
# camera actually offers and decides where photos land.
#
# The EMEET exposes two nodes; /dev/video1 is metadata-only, so video0 is the capture one.
# mpv prints a handful of VIDIOC_QBUF "Inappropriate ioctl" lines when it closes the
# device. They are shutdown noise, not a failure — the stream decodes normally.
set -e
dev=${1:-/dev/video0}
dir="$HOME/Pictures/Camera"
mkdir -p "$dir"

# hflip so the preview reads as a mirror, the way every other webcam app shows you.
# Photos save flipped to match what you framed; drop --vf=hflip for true orientation.
exec mpv "av://v4l2:$dev" \
    --demuxer-lavf-o=input_format=mjpeg,video_size=1920x1080 \
    --profile=low-latency --untimed \
    --vf=hflip \
    --title=nullgrid-cam \
    --screenshot-directory="$dir" \
    --screenshot-template="%tY%tm%td-%tH%tM%tS" \
    --screenshot-format=png \
    --osd-playing-msg="s photo   f fullscreen   q quit"

#!/bin/sh
# Unlock the login keyring for this session and make it the Secret Service.
# pam_gnome_keyring in /etc/pam.d/greetd normally does this at login; this is the manual
# fallback for when it does not (wrong keyring name, or a session started outside greetd).
owner() {
    timeout 5 busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus GetConnectionUnixProcessID s org.freedesktop.secrets 2>/dev/null
}

if [ -t 0 ]; then
    printf 'Keyring password: ' >&2
    stty -echo 2>/dev/null
    read -r pw
    stty echo 2>/dev/null
    printf '\n' >&2
else
    read -r pw
fi

before=$(owner)
printf '%s\n' "$pw" | gnome-keyring-daemon --replace --unlock --components=secrets >/dev/null 2>&1 &

# Two traps here. --replace hands the bus over asynchronously, so until the owning PID
# changes we are still querying the OLD daemon — which answers "unlocked" no matter what
# password was just typed. And a wrong password still starts a daemon and still exports
# org.freedesktop.secrets; only the collection stays locked. So: wait for the handover,
# then check the collection's Locked property rather than the presence of the bus name.
i=0
while [ "$i" -lt 40 ]; do
    now=$(owner)
    [ -n "$now" ] && [ "$now" != "$before" ] && break
    i=$((i + 1))
    sleep 0.25
done

state=$(timeout 5 busctl --user get-property org.freedesktop.secrets \
    /org/freedesktop/secrets/aliases/default \
    org.freedesktop.Secret.Collection Locked 2>/dev/null)

case "$state" in
    "b false") echo "keyring unlocked" >&2 ;;
    "b true")  echo "keyring is still locked — wrong password" >&2; exit 1 ;;
    *)         echo "keyring did not come up" >&2; exit 1 ;;
esac
